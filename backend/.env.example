RISKSHIELD_SECRET_KEY=your-secret-key-here
RISKSHIELD_DATA_DIR=data

# ── AI Risk Copilot (optional — RiskShield works without these) ──────────────
# Set these to enable the local Zephyr-7B Copilot via Ollama.
# If omitted, the Copilot shows an "unavailable" message but everything else
# continues working normally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=zephyr:7b-beta
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=1024

# Optional: Hugging Face API key (fallback if Ollama is not installed)
# HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx
